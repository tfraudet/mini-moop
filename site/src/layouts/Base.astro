---
import { getImage } from 'astro:assets';
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';
import { languages, otherLang, t, type Lang } from '../i18n';
import { REPO_URL } from '../lib/release';
import icon from '../assets/icon.png';
import panel from '../assets/panel-classic.jpg';
import '../styles/global.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const other = otherLang(lang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const ogImage = await getImage({ src: panel, width: 1200, format: 'jpg' });
const ogUrl = new URL(ogImage.src, Astro.site).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tr.meta.title}</title>
    <meta name="description" content={tr.meta.description} />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="canonical" href={getAbsoluteLocaleUrl(lang)} />
    {languages.map((l) => <link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l)} />)}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('en')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={tr.meta.title} />
    <meta property="og:description" content={tr.meta.description} />
    <meta property="og:url" content={getAbsoluteLocaleUrl(lang)} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="dark" />
  </head>
  <body>
    <header class="site-header">
      <nav class="wrap nav" aria-label="Main">
        <a class="brand" href={getRelativeLocaleUrl(lang)}>
          <img src={icon.src} width="32" height="32" alt="" />
          <span>Mini Moop</span>
        </a>
        <ul class="nav-links">
          <li><a href="#how">{tr.nav.how}</a></li>
          <li><a href="#listen">{tr.nav.listen}</a></li>
          <li><a href="#download">{tr.nav.download}</a></li>
          <li>
            <a class="github-link" href={REPO_URL} rel="noopener"
               aria-label={tr.nav.github} title={tr.nav.github}>
              <svg class="github-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.16c-3.2.7-3.87-1.36-3.87-1.36-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.77.11 3.06.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.18c0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
              </svg>
            </a>
          </li>
          <li>
            <a class="lang" href={getRelativeLocaleUrl(other)} hreflang={other} lang={other}
               aria-label={tr.nav.otherLanguageLabel} title={tr.nav.otherLanguageLabel}>
              {tr.nav.otherLanguage}
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          {`${tr.footer.license} ${tr.footer.builtWith} `}
          <a href={REPO_URL} rel="noopener">{tr.footer.source}</a>
        </p>
        <p class="small">{tr.footer.trademark} {tr.footer.vstTrademark} {tr.footer.auTrademark}</p>
      </div>
    </footer>
  </body>
</html>
