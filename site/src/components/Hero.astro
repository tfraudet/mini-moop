---
import { Image } from 'astro:assets';
import { t, type Lang } from '../i18n';
import { REPO_URL } from '../lib/release';
import FormatIcon from './FormatIcon.astro';
import PlatformIcon from './PlatformIcon.astro';
import icon from '../assets/icon.png';
import modern from '../assets/panel-modern.jpg';
import classic from '../assets/panel-classic.jpg';

interface Props { lang: Lang }
const tr = t(Astro.props.lang).hero;
const sizes = '(min-width: 1200px) 1140px, 100vw';
const widths = [700, 1140, 1600, 2280];
---
<section class="hero">
  <div class="wrap">
    <div class="hero-text">
      <Image src={icon} width={96} height={96} alt="" class="hero-icon" loading="eager" />
      <h1>Mini Moop</h1>
      <p class="tagline">{tr.tagline}</p>
      <div class="hero-details">
        <p class="lead">{tr.lead}</p>
        <div class="hero-compatibility" role="group" aria-label={tr.compatibility}>
          <div class="hero-compat-group">
            <p class="sr-only" id="hero-platforms">{tr.platforms}</p>
            <ul aria-labelledby="hero-platforms">
              <li>
                <span class="hero-compat-icon platform-mark-macos"><PlatformIcon platform="macos" /></span>
                <span class="sr-only">macOS</span>
              </li>
              <li>
                <span class="hero-compat-icon platform-mark-windows"><PlatformIcon platform="windows" /></span>
                <span class="sr-only">Windows</span>
              </li>
            </ul>
          </div>
          <div class="hero-compat-group">
            <p class="sr-only" id="hero-formats">{tr.formats}</p>
            <ul aria-labelledby="hero-formats">
              <li>
                <span class="hero-compat-logo" aria-hidden="true"><FormatIcon format="vst3" /></span>
                <span class="sr-only">VST 3</span>
              </li>
              <li>
                <span class="hero-compat-logo" aria-hidden="true"><FormatIcon format="au" /></span>
                <span class="sr-only">Audio Units</span>
              </li>
              <li>
                <span class="hero-compat-icon hero-app-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                       stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2.5" y="3.5" width="19" height="17" rx="2" />
                    <path d="M2.5 7.5h19M6 4.7v1.6M8.5 4.7v1.6M6.5 12v5h11v-5M10 12v5m4-5v5" />
                  </svg>
                </span>
                <span class="sr-only">{tr.standalone}</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
      <p class="actions">
        <a class="button primary" href="#download">{tr.download}</a>
        <a class="button" href={REPO_URL} rel="noopener">{tr.source}</a>
      </p>
    </div>

    <!-- Theme switch without JavaScript: the checked radio shows its image -->
    <div class="panel-shot">
      <input type="radio" name="theme" id="theme-classic" checked />
      <input type="radio" name="theme" id="theme-modern" />
      <div class="theme-switch" role="group" aria-label={tr.themes}>
        <span>{tr.themes}</span>
        <label for="theme-classic">{tr.classic}</label>
        <label for="theme-modern">{tr.modern}</label>
      </div>
      <div class="shots">
        <Image src={classic} widths={widths} sizes={sizes} alt={tr.panelAlt} class="shot shot-classic" loading="eager" fetchpriority="high" />
        <Image src={modern} widths={widths} sizes={sizes} alt={tr.panelAlt} class="shot shot-modern" />
      </div>
    </div>
  </div>
</section>
