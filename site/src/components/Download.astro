---
import { fill, t, type Lang } from '../i18n';
import { platforms, getLatestRelease } from '../lib/release';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang).download;
const release = await getLatestRelease();
const date = release.date
  ? new Intl.DateTimeFormat(lang, { dateStyle: 'long', timeZone: 'UTC' }).format(release.date)
  : '';
const quarantine = [
  'xattr -dr com.apple.quarantine "/Applications/Mini Moop.app"',
  'xattr -dr com.apple.quarantine ~/Library/Audio/Plug-Ins/VST3/"Mini Moop.vst3"',
  'xattr -dr com.apple.quarantine ~/Library/Audio/Plug-Ins/Components/"Mini Moop.component"',
].join('\n');
---
<section id="download" class="section">
  <div class="wrap">
    <h2>{tr.title}</h2>
    <p class="intro">{tr.intro}</p>
    <p class="release-info">
      {release.version
        ? <a href={release.url} rel="noopener">{fill(tr.version, { version: release.version, date })}</a>
        : tr.noRelease}
    </p>

    <div class="formats">
      {platforms.map((platform) => (
        <a class="format" href={release.links[platform] ?? release.url} rel="noopener">
          <span class="format-head" aria-hidden="true">
            {platform === 'macos' ? (
              <span class="platform-mark platform-mark-macos">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M18.7 19.5c-.8 1.2-1.7 2.4-3 2.5-1.3 0-1.8-.8-3.3-.8s-2 .8-3.3.8c-1.3 0-2.3-1.3-3.1-2.6-1.7-2.5-3-7-1.3-10.1.9-1.5 2.5-2.5 4.2-2.5 1.3 0 2.5.9 3.3.9s2.2-1.1 3.8-.9c.6 0 2.4.3 3.6 2-.1.1-2.1 1.3-2.1 3.8 0 3 2.6 3.9 2.6 4-.1.1-.5 1.4-1.3 2.9ZM14 3.5c.7-.8 1.8-1.4 2.8-1.5.1 1.1-.3 2.2-1 3-.7.8-1.7 1.4-2.8 1.4-.1-1.1.4-2.2 1-2.9Z" />
                </svg>
              </span>
            ) : (
              <span class="platform-mark platform-mark-windows">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M1.5 4.1 10.4 2.9v8.4H1.5V4.1Zm10.1-1.4 10.9-1.6v10.2H11.6V2.7ZM1.5 12.5h8.9v8.4l-8.9-1.2v-7.2Zm10.1 0h10.9v10.2l-10.9-1.6V12.5Z" />
                </svg>
              </span>
            )}
            <span class="format-glyph">{platform === 'macos' ? 'UNIVERSAL' : 'X64'}</span>
          </span>
          <span class="format-name">{tr.platforms[platform].name}</span>
          <span class="format-detail">{tr.platforms[platform].detail}</span>
          <span class="format-install">{tr.platforms[platform].requirements}</span>
          <span class="format-cta">
            {release.links[platform] ? tr.downloadZip : tr.archivePending} →
          </span>
        </a>
      ))}
    </div>
    <p class="requirements">{tr.installIntro}</p>

    <div class="install-notes">
      {platforms.map((platform) => (
        <div>
          <h3>{tr.platforms[platform].name}</h3>
          <p>{tr.platforms[platform].install}</p>
        </div>
      ))}
    </div>

    <div class="quarantine">
      <h3>{tr.quarantineTitle}</h3>
      <p>{tr.quarantineText}</p>
      <div class="code">
        <pre><code>{quarantine}</code></pre>
        <button type="button" class="copy" data-copied={tr.copied}>{tr.copy}</button>
      </div>
    </div>

    <p><a href={release.all} rel="noopener">{tr.allReleases} →</a></p>
  </div>
</section>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.quarantine .copy')) {
    const label = button.textContent;
    button.addEventListener('click', async () => {
      const code = button.parentElement?.querySelector('code')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = button.dataset.copied ?? label;
        setTimeout(() => (button.textContent = label), 2000);
      } catch {
        /* clipboard refused: the text can still be selected by hand */
      }
    });
  }
</script>
